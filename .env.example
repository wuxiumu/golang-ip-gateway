# 复制为 .env 后按需填写。.env 已被 git 忽略，不要提交。
# 空值不会覆盖 config.yaml。Docker Compose 会自动读取本目录的 .env 做变量替换。

# 进程监听。仓库示例与 compose 端口映射都是 18080，改这里时要同时改 compose 右侧端口。
IPGW_LISTEN=

# 管理接口令牌。非空后请求需带 Header: X-Admin-Token
IPGW_ADMIN_TOKEN=

# 未命中规则时的跳转地址
IPGW_DEFAULT_TARGET=

# 管理端跨域来源，默认 *
IPGW_CORS_ORIGIN=

# Compose 网络内应指向服务名。宿主机直跑可留空，沿用 yaml 的 127.0.0.1:6379
IPGW_REDIS_ADDR=
IPGW_REDIS_PASSWORD=
IPGW_REDIS_DB=
IPGW_REDIS_KEY=

# info 或 debug
IPGW_LOG_LEVEL=
# true / false。true 时记录每次 302
IPGW_LOG_ACCESS=
# release / debug / test
IPGW_GIN_MODE=

# 每客户端 IP 每秒放行数。0 或留空表示关闭
IPGW_RATE_LIMIT_RPS=
IPGW_RATE_LIMIT_BURST=

# 仅给 docker compose 的宿主机映射端口用，不传入网关进程
IPGW_PUBLISH_PORT=18080
